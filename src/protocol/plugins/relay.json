{
  "id": "relay",
  "name": "Relay",
  "version": "0.1.0",
  "description": "HTTP client, request inspector, mock server.",
  "panel": {
    "icon": "Send",
    "label": "Relay",
    "color": "#a371f7",
    "component": "panels/relay/RelayPanel"
  },
  "workspace_scoped": true,
  "events": {
    "publishes": [
      "relay.mock_started",
      "relay.mock_stopped",
      "relay.request_failed",
      "relay.request_sent",
      "relay.response_received"
    ],
    "subscribes": [
      "pulse.port_listening"
    ]
  },
  "embed": {
    "mode": "native",
    "bridge": "plugins/relay"
  },
  "min_depot": "0.1.0",
  "handoff": {
    "app": "Relay",
    "args": [
      "--url",
      "{workspace.tools.relay.base_url}"
    ]
  }
}
